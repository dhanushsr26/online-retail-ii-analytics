	partition Dim_Customer = m
		mode: import
		source =
				let
				    // ================================================================
				    // Dim_Customer - one row per customer, aggregated from the cleaned fact.
				    // Derived by 01_scripts/03_clean.py in the same cleaning run that
				    // produces Fact_Sales, then written out as CSV. Techniques applied
				    // upstream, per BA-6 Preprocessing Techniques.pdf:
				    //   - RFM scoring - quintile discretization of Recency/Frequency/Monetary
				    //   - Min-Max normalization and Z-score standardization of the same three
				    //   - Segment, CRM strategy, churn status and CLV derived from the scores
				    // Regenerate with:  python 01_scripts/03_clean.py
				    // Verify with:      python 01_scripts/04_validate.py
				    // ================================================================
				
				    Source = Csv.Document(File.Contents(SourceFolder & "\02_clean\Dim_Customer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Set Data Types" = Table.TransformColumnTypes(#"Promoted Headers", {{"CustomerKey", Int64.Type}, {"Recency", type number}, {"Frequency", type number}, {"Monetary", type number}, {"FirstPurchase", type text}, {"LastPurchase", type text}, {"UnitsBought", type number}, {"LinesBought", type number}, {"TenureDays", type number}, {"AvgOrderValue", type number}, {"Recency_MinMax", type number}, {"Recency_Z", type number}, {"Frequency_MinMax", type number}, {"Frequency_Z", type number}, {"Monetary_MinMax", type number}, {"Monetary_Z", type number}, {"R_Score", type number}, {"F_Score", type number}, {"M_Score", type number}, {"RFM_Score", type number}, {"RFM_Sum", type number}, {"Segment", type text}, {"RecencyBand", type text}, {"ValueTier", type text}, {"CRM_Strategy", type text}, {"CRM_Action", type text}, {"ChurnStatus", type text}, {"IsChurned", type logical}, {"PurchaseFrequencyPerYear", type number}, {"CLV", type number}})
				in
				    #"Set Data Types"

