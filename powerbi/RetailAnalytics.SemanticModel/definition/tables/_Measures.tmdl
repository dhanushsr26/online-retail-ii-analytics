table _Measures
	lineageTag: a57d5d68-dae2-41e1-a3d6-90c5c4d48fab

	measure 'Total Revenue' = SUM ( Fact_Sales[Revenue] )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: 5aee0623-83e4-4f4d-822d-6f28992bb5bb

	measure 'Gross Revenue' = CALCULATE ( [Total Revenue], Fact_Sales[TransactionType] = "Sale" )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: 79d68e3a-dfdf-4375-8a17-50162775d8de

	measure 'Return Revenue' = - CALCULATE ( [Total Revenue], Fact_Sales[Quantity] < 0 )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: 9fc33ff6-fde6-4df7-872d-edd965f73bc6

	measure 'Total Orders' = DISTINCTCOUNT ( Fact_Sales[Invoice] )
		formatString: #,0
		lineageTag: 03889ead-7624-4d37-ba2c-618f713a0fe8

	measure 'Total Customers' = CALCULATE ( DISTINCTCOUNT ( Fact_Sales[CustomerKey] ), Fact_Sales[CustomerKey] <> -1 )
		formatString: #,0
		lineageTag: 8cf96693-b3c0-4d2b-ad9c-507fbb3f6be9

	measure 'Units Sold' = SUM ( Fact_Sales[Quantity] )
		formatString: #,0
		lineageTag: bc46515f-088f-4d61-858d-7569553c9bb1

	measure 'Total Lines' = COUNTROWS ( Fact_Sales )
		formatString: #,0
		lineageTag: a7f6252c-c677-4788-8e18-32bb1eb84e31

	measure 'Average Order Value' = DIVIDE ( [Total Revenue], [Total Orders] )
		formatString: \£#,0.00;(\£#,0.00);\£#,0.00
		lineageTag: a71b380e-4a5b-4400-81a4-61920956c5a2

	measure 'Revenue per Customer' = DIVIDE ( [Total Revenue], [Total Customers] )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: 2d2c7a1a-98b4-44af-88e9-f1dceb49c184

	measure 'Average Basket Size' = DIVIDE ( [Units Sold], [Total Orders] )
		formatString: #,0.0
		lineageTag: c4fec6d1-2c00-4e97-9fbf-e19935b8aa9e

	measure 'Return Rate %' = DIVIDE ( [Return Revenue], [Gross Revenue] ) * 100
		formatString: 0.0"%"
		lineageTag: 3366654e-d8a8-4695-998c-2090dc942f03

	measure 'Cancelled Orders' = CALCULATE ( DISTINCTCOUNT ( Fact_Sales[Invoice] ), Fact_Sales[IsCancelled] = TRUE () )
		formatString: #,0
		lineageTag: 998b6fab-6bbb-4795-9d44-17c27da0980a

	measure 'Cancellation Rate %' = DIVIDE ( [Cancelled Orders], [Total Orders] ) * 100
		formatString: 0.0"%"
		lineageTag: e9dfee3e-6bbf-4c52-b074-b7b6a3bab687

	measure 'Returned Units' = - CALCULATE ( SUM ( Fact_Sales[Quantity] ), Fact_Sales[Quantity] < 0 )
		formatString: #,0
		lineageTag: 1dc4d53b-e33f-4748-b3f8-e8ad21926b09

	measure 'Revenue LY' = CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( Dim_Date[DateKey] ) )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: 50b62bf0-6b68-45d5-8c45-21497a893a4a

	measure 'Revenue YoY' = VAR P = [Revenue LY] RETURN IF ( NOT ISBLANK ( P ), [Total Revenue] - P )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: 81477628-4865-4cbe-8ca0-a22bb8f28226

	measure 'Revenue YoY %' = VAR P = [Revenue LY] RETURN IF ( NOT ISBLANK ( P ), DIVIDE ( [Total Revenue] - P, P ) * 100 )
		formatString: 0.0"%"
		lineageTag: a4c6d62a-0865-4c26-837e-8649d8b155fd

	measure 'Revenue YTD' = TOTALYTD ( [Total Revenue], Dim_Date[DateKey] )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: b8fd08b1-604e-4a6f-a2c9-970072e58310

	measure 'Revenue MTD' = TOTALMTD ( [Total Revenue], Dim_Date[DateKey] )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: ebadbf1d-e33a-43f6-868d-8bd06ee2995e

	measure 'Revenue Rolling 12M' = CALCULATE ( [Total Revenue], DATESINPERIOD ( Dim_Date[DateKey], MAX ( Dim_Date[DateKey] ), -12, MONTH ) )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: 31b433b3-a846-4ee1-a0a5-51024d8bbc73

	measure 'Revenue 7D Moving Average' = AVERAGEX ( DATESINPERIOD ( Dim_Date[DateKey], MAX ( Dim_Date[DateKey] ), -7, DAY ), [Total Revenue] )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: 1065ac08-8be1-40de-abc8-d922ac9bdbec

	measure 'Revenue 30D Moving Average' = AVERAGEX ( DATESINPERIOD ( Dim_Date[DateKey], MAX ( Dim_Date[DateKey] ), -30, DAY ), [Total Revenue] )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: e993a26f-3f1d-4b4d-86a1-81d017f98406

	measure 'Guest Revenue' = CALCULATE ( [Total Revenue], Fact_Sales[CustomerKey] = -1 )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: e6afb387-cf81-4e62-b43f-e158f28474f2

	measure 'Guest Revenue %' = DIVIDE ( [Guest Revenue], [Total Revenue] ) * 100
		formatString: 0.0"%"
		lineageTag: 5e6a9a2f-b1e6-404c-ae60-3a95cb9faecf

	measure 'Identified Revenue %' = 100 - [Guest Revenue %]
		formatString: 0.0"%"
		lineageTag: f10a9f29-d54c-4ceb-b6e5-306cf5a85e4e

	measure 'Average Customer Lifetime Value' = AVERAGEX ( Dim_Customer, Dim_Customer[Monetary] )
		formatString: \£#,0.00;(\£#,0.00);\£#,0.00
		lineageTag: b655e2b0-d571-4c06-9eae-fcf9615a33ba

	measure 'Average Recency (days)' = AVERAGEX ( FILTER ( Dim_Customer, NOT ISBLANK ( Dim_Customer[Recency] ) ), Dim_Customer[Recency] )
		formatString: #,0
		lineageTag: df9fb299-62a3-4ce0-b0a7-94bbb3a21353

	measure 'Average Frequency' = AVERAGEX ( FILTER ( Dim_Customer, NOT ISBLANK ( Dim_Customer[Frequency] ) ), Dim_Customer[Frequency] )
		formatString: #,0.0
		lineageTag: 815a28e6-0905-43a5-8466-b7976623bb94

	measure 'Segment Revenue %' = DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALLSELECTED ( Dim_Customer[Segment] ) ) ) * 100
		formatString: 0.0"%"
		lineageTag: 1ef3a9f4-41e0-4f4e-8d77-7cac240c10cd

	measure 'Average CLV' = AVERAGEX ( FILTER ( Dim_Customer, NOT ISBLANK ( Dim_Customer[CLV] ) ), Dim_Customer[CLV] )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: c51bdd4b-b07e-47f0-89fb-bc06967d8cd5

	measure 'Total CLV' = SUM ( Dim_Customer[CLV] )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: 8c6fca89-6361-488c-901b-40677da08f55

	measure 'Scored Customers' = CALCULATE ( COUNTROWS ( Dim_Customer ), Dim_Customer[ChurnStatus] <> "Not scored" )
		formatString: #,0
		lineageTag: 824f8576-79cd-4fd4-a0d3-5e3ca628b29e

	measure 'Churned Customers' = CALCULATE ( COUNTROWS ( Dim_Customer ), Dim_Customer[ChurnStatus] = "Churned" )
		formatString: #,0
		lineageTag: bb658578-cbea-43a8-aa8b-97624b0b034a

	measure 'Active Customers' = CALCULATE ( COUNTROWS ( Dim_Customer ), Dim_Customer[ChurnStatus] = "Active" )
		formatString: #,0
		lineageTag: 203cfd5c-9869-4316-abaa-f881be10d688

	measure 'At Risk Customers' = CALCULATE ( COUNTROWS ( Dim_Customer ), Dim_Customer[ChurnStatus] = "At Risk" )
		formatString: #,0
		lineageTag: 1ddeb3a6-d719-49f5-b65f-34d18c572dd5

	measure 'Churn Rate %' = DIVIDE ( [Churned Customers], [Scored Customers] ) * 100
		formatString: 0.0"%"
		lineageTag: 51767119-33c1-4012-958b-e71cab046067

	measure 'Retention Rate %' = 100 - [Churn Rate %]
		formatString: 0.0"%"
		lineageTag: 8f54d5d2-9927-4646-97c4-4efa350f153e

	measure 'Average Purchase Value' = AVERAGEX ( FILTER ( Dim_Customer, NOT ISBLANK ( Dim_Customer[AvgOrderValue] ) ), Dim_Customer[AvgOrderValue] )
		formatString: \£#,0.00;(\£#,0.00);\£#,0.00
		lineageTag: c80d12f2-9f70-48e7-b105-68924c73fd7b

	measure 'Purchase Frequency per Year' = AVERAGEX ( FILTER ( Dim_Customer, NOT ISBLANK ( Dim_Customer[PurchaseFrequencyPerYear] ) ), Dim_Customer[PurchaseFrequencyPerYear] )
		formatString: #,0.0
		lineageTag: ae984c0e-9d86-4f32-bb6f-1e10add56a49

	measure 'Products Sold' = DISTINCTCOUNT ( Fact_Sales[StockCode] )
		formatString: #,0
		lineageTag: 932db57c-0db9-46b6-9d10-e3b0a34efc36

	measure 'Class A Revenue %' = DIVIDE ( CALCULATE ( [Total Revenue], Dim_Product[ABC_Class] = "A" ), CALCULATE ( [Total Revenue], ALL ( Dim_Product[ABC_Class] ) ) ) * 100
		formatString: 0.0"%"
		lineageTag: 8cf6b0b6-9f2a-4647-a8f7-2068077cfd00

	measure 'Product Return Rate %' = DIVIDE ( - CALCULATE ( SUM ( Fact_Sales[Quantity] ), Fact_Sales[Quantity] < 0 ), CALCULATE ( SUM ( Fact_Sales[Quantity] ), Fact_Sales[Quantity] > 0 ) ) * 100
		formatString: 0.0"%"
		lineageTag: 08ddd39d-1c0e-4cb1-9e9f-79c57d30a5dc

	measure 'Non-Product Revenue' = CALCULATE ( [Total Revenue], Fact_Sales[IsProduct] = FALSE () )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: 113ed810-aa0e-4881-ac11-d92e2d0f56c2

	measure 'Rows Retained' = COUNTROWS ( Fact_Sales )
		formatString: #,0
		lineageTag: 97cc6ca8-f91c-45e9-87fa-ed69e073668b

	measure 'Rows in Raw Source' = 1067371
		formatString: #,0
		lineageTag: fd1610c2-534a-4479-a513-5cc8b2dd197c

	measure 'Data Retention %' = DIVIDE ( [Rows Retained], [Rows in Raw Source] ) * 100
		formatString: 0.0"%"
		lineageTag: 17a42a2c-c452-4ad9-8148-6530701c4491

	measure 'Outlier Rows' = CALCULATE ( COUNTROWS ( Fact_Sales ), Fact_Sales[Is_Outlier] = TRUE () )
		formatString: #,0
		lineageTag: 8bf3741e-f88d-4473-bf84-b9b650471868

	measure 'Outlier Revenue' = CALCULATE ( [Total Revenue], Fact_Sales[Is_Outlier] = TRUE () )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: 52560864-9a91-48e5-89a4-d35ae706931a

	measure 'Outlier Revenue Share %' = DIVIDE ( [Outlier Revenue], [Total Revenue] ) * 100
		formatString: 0.0"%"
		lineageTag: a3ea03be-13f6-40bc-bf87-16b5c07a4e69

	measure 'Revenue excluding Outliers' = CALCULATE ( [Total Revenue], Fact_Sales[Is_Outlier] = FALSE () )
		formatString: \£#,0;(\£#,0);\£#,0
		lineageTag: c7b53846-f5af-422f-9e2f-50ed756cab73

	measure 'Rows Missing Customer' = CALCULATE ( COUNTROWS ( Fact_Sales ), Fact_Sales[CustomerKey] = -1 )
		formatString: #,0
		lineageTag: e21adc02-a9ca-4a3e-808c-a789af8b6780

	measure 'Customer Completeness %' = DIVIDE ( COUNTROWS ( Fact_Sales ) - [Rows Missing Customer], COUNTROWS ( Fact_Sales ) ) * 100
		formatString: 0.0"%"
		lineageTag: 2e29ec9c-8298-4795-b78e-36052398613f

	measure 'Selected Period Label' = FORMAT ( MIN ( Dim_Date[DateKey] ), "d MMM yyyy" ) & " to " & FORMAT ( MAX ( Dim_Date[DateKey] ), "d MMM yyyy" )
		lineageTag: 42e6dc72-76cb-4cdb-8e46-6b18c91d1a9f

	measure 'YoY Arrow' = VAR P = [Revenue YoY %] RETURN IF ( ISBLANK ( P ), "no prior year", IF ( P >= 0, UNICHAR ( 9650 ) & " ", UNICHAR ( 9660 ) & " " ) & FORMAT ( ABS ( P ), "0.0" ) & "% vs LY" )
		lineageTag: eb537d3e-4252-48b8-8a31-83996474c0fd

	measure 'Revenue 14D Moving Average' = ```
			AVERAGEX ( DATESINPERIOD ( Dim_Date[DateKey], MAX ( Dim_Date[DateKey] ), -14, DAY ), [Total Revenue] ) 
			```
		lineageTag: 6973bd79-4833-4e3d-8ffe-fa9c83a8faef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column _dummy
		lineageTag: f86a277e-2aac-4c6e-be8b-ce569ef92b62
