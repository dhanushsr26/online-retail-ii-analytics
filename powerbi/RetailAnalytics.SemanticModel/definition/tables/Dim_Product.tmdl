	partition Dim_Product = m
		mode: import
		source =
				let
				    // ================================================================
				    // Dim_Product - one row per stock code, aggregated from the cleaned fact.
				    // Derived by 01_scripts/03_clean.py in the same cleaning run that
				    // produces Fact_Sales, then written out as CSV. Techniques applied
				    // upstream, per BA-6 Preprocessing Techniques.pdf:
				    //   - Item type classification - product / postage / fee / adjustment
				    //   - Price banding - discretization of average unit price
				    //   - ABC classification - cumulative revenue share, Pareto cut-offs
				    // Regenerate with:  python 01_scripts/03_clean.py
				    // Verify with:      python 01_scripts/04_validate.py
				    // ================================================================
				
				    Source = Csv.Document(File.Contents(SourceFolder & "\02_clean\Dim_Product.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Set Data Types" = Table.TransformColumnTypes(#"Promoted Headers", {{"StockCode", type text}, {"Description", type text}, {"ItemType", type text}, {"IsProduct", type logical}, {"AvgPrice", type number}, {"MinPrice", type number}, {"MaxPrice", type number}, {"UnitsSold", Int64.Type}, {"Revenue", type number}, {"TimesSold", Int64.Type}, {"PriceBand", type text}, {"CumRevenuePct", type number}, {"ABC_Class", type text}})
				in
				    #"Set Data Types"

